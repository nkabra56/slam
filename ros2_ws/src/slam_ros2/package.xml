<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_ros2</name>
  <version>0.1.0</version>
  <description>
    ROS2 wrapper for the slam project's VIO/LiDAR/backend/mapping pipeline.
    Depends on slam_core via find_package(CONFIG), not rosdep -- see root
    README.md's ROS2 section for how to make it discoverable.
  </description>
  <maintainer email="nkabra56@gmail.com">Nishant Kabra</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
